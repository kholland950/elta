{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2020"],
    "target": "es2020",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "noImplicitAny": true,
    "alwaysStrict": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": false,
    "jsx": "react",
    "strict": true,
    "paths": {
      "app/*": ["./src/app/*"],
      "game/*": ["./src/game/*"]
    },
    "noUnusedLocals": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "noUnusedParameters": true,
    "pretty": true,
    "preserveConstEnums": true,
    "stripInternal": true,
    "typeRoots": [
      "src/types",
      "node_modules/@types"
    ]
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
